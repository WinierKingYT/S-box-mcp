<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>mcp_server</AssemblyName>
		<Version>1.2.0</Version>
		<PackageId>mcp_server</PackageId>
		<LangVersion>14</LangVersion>
		<NoWarn>1701;1702;1591;</NoWarn>
		<WarningsAsErrors></WarningsAsErrors>
		<TreatWarningsAsErrors>False</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DefineConstants>SANDBOX;MCP_ENABLED</DefineConstants>
		<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
		<SboxRoot Condition="'$(SboxRoot)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\sbox</SboxRoot>
		<OutputPath>$(SboxRoot)\.vs\output\</OutputPath>
		<DocumentationFile>$(SboxRoot)\.vs\output\mcp_server.xml</DocumentationFile>
		<RootNamespace>Sandbox</RootNamespace>
		<Nullable>disable</Nullable>
		<DefaultItemExcludes>$(DefaultItemExcludes);**/editor/**;**/unittest/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
		<Using Include="Microsoft.AspNetCore.Components" />
		<Using Include="Microsoft.AspNetCore.Components.Rendering" />
	</ItemGroup>

	<ItemGroup>
		<Analyzer Include="$(SboxRoot)\bin\managed\Sandbox.CodeUpgrader.dll"/>
		<Analyzer Include="$(SboxRoot)\bin\managed\Sandbox.Generator.dll"/>
		<Reference Include="$(SboxRoot)\bin\managed\Sandbox.System.dll"/>
		<Reference Include="$(SboxRoot)\bin\managed\Sandbox.Engine.dll"/>
		<Reference Include="$(SboxRoot)\bin\managed\Sandbox.Filesystem.dll"/>
		<Reference Include="$(SboxRoot)\bin\managed\Sandbox.Reflection.dll"/>
		<Reference Include="$(SboxRoot)\bin\managed\Sandbox.Mounting.dll"/>
		<Reference Include="$(SboxRoot)\bin\managed\Microsoft.AspNetCore.Components.dll"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(SboxRoot)\addons\base\code\Base Library.csproj" />
	</ItemGroup>

</Project>
